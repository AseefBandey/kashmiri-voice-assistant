# Example configuration file
project:
  name: "FinalYearProject"
  version: "0.1.0"
  random_seed: 42

paths:
  data_dir: "data"
  raw_data: "data/raw"
  processed_data: "data/processed"
  models_dir: "models"
  reports_dir: "reports"

training:
  batch_size: 16
  learning_rate: 0.0001
  num_epochs: 10
